# Bifröst — copy to .env and edit before first run.

# === required ===
VIEWER_DB_URL=postgresql:///knowledge
VIEWER_TOKEN=change-me-to-a-real-secret
VIEWER_OLLAMA_URL=http://localhost:11434
VIEWER_EMBED_MODEL=nomic-embed-text
VIEWER_CHAT_MODEL=llama3.2:3b

# === bind ===
# Default: tailscale interface. Set to 127.0.0.1 for localhost-only.
VIEWER_BIND_HOST=0.0.0.0
VIEWER_PORT=8731

# === graph build tuning ===
VIEWER_EDGE_TOP_K=4
VIEWER_EDGE_MIN_SIM=0.55
VIEWER_HDBSCAN_MIN_CLUSTER=8
VIEWER_EDGE_LABEL_TERMS=4

# Loopback remains available when the tailnet interface is absent.
VIEWER_LOOPBACK_HOST=127.0.0.1
VIEWER_DB_TIMEOUT=5
VIEWER_RECOVERY_INTERVAL=30
VIEWER_BUILD_RETRY_DELAY=120
VIEWER_EDGE_BLOCK_SIZE=256
VIEWER_BUILD_STALL_AFTER_SEC=600
# Optional isolated state directories (default: project .cache/ and logs/)
# VIEWER_CACHE_DIR=
# VIEWER_LOG_DIR=

# Bundled ingest source; private configuration/data can stay outside the checkout.
# VIEWER_INGEST_PROJECT_DIR=/path/to/alternative/ingest-source
# INGEST_ENV_FILE=/path/to/private/ingest.env
# INGEST_STATE_DIR=/path/to/private/ingest-state
# INGEST_PROJECT_DIR=/path/to/alternative/ingest-source
# INGEST_WATCH_POLL_SECONDS=5
# INGEST_WATCH_SETTLE_SECONDS=3
# INGEST_WATCH_RETRY_SECONDS=30
# INGEST_WATCH_RETRY_MAX_SECONDS=3600
# INGEST_WATCH_JOB_TIMEOUT=900
