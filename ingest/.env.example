# Copy to .env, or select an existing private file with INGEST_ENV_FILE.
INGEST_DB_URL=postgresql:///knowledge
OLLAMA_URL=http://localhost:11434
INGEST_EMBED_MODEL=nomic-embed-text
INGEST_CHUNK_CHARS=2000
INGEST_CHUNK_OVERLAP=200
INGEST_DB_CONNECT_TIMEOUT=5
INGEST_EMBED_BATCH_SIZE=32

# Optional durable inbox location (defaults to this ingest project).
# INGEST_STATE_DIR=/path/to/private/ingest-state
INGEST_WATCH_POLL_SECONDS=5
INGEST_WATCH_SETTLE_SECONDS=3
INGEST_WATCH_RETRY_SECONDS=30
INGEST_WATCH_RETRY_MAX_SECONDS=3600
INGEST_WATCH_JOB_TIMEOUT=900
