[Unit]
Description=Second-brain inbox ingestion with durable retries
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/ai/ingest
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=%h/.local/bin/uv run --frozen %h/ai/ingest/watch.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=control-group

[Install]
WantedBy=default.target
