[Unit]
Description=Second-brain inbox ingestion with durable retries
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/ai/ingest-viewer
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Existing private configuration and inbox remain outside the source checkout.
Environment=INGEST_ENV_FILE=%h/ai/ingest/.env
Environment=INGEST_STATE_DIR=%h/ai/ingest
ExecStart=%h/.local/bin/uv run --frozen --project %h/ai/ingest-viewer/ingest %h/ai/ingest-viewer/scripts/watch_inbox.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=control-group

[Install]
WantedBy=default.target
